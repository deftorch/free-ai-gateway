# === Database (Postgres via Vercel Marketplace -> Neon) ===
# Isi otomatis kalau `vercel install neon` sudah dijalankan & di-link.
DATABASE_URL=

# === Redis (via Vercel Marketplace -> Upstash) ===
# Isi otomatis kalau `vercel install upstash` sudah dijalankan & di-link.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# === Enkripsi key provider (AES-GCM) ===
# WAJIB 32 byte, base64. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# JANGAN simpan di database — hanya di environment variable.
KEY_ENCRYPTION_SECRET=

# === Auth internal (untuk /internal/keys, /internal/health) ===
# Token terpisah dari token gateway biasa — dipakai untuk manajemen key & dashboard.
INTERNAL_ADMIN_TOKEN=

# === Cron ===
# Auto-provisioned oleh Vercel untuk cron native. Untuk trigger eksternal
# (scheduler pihak ketiga di Hobby plan, lihat checklist §2.3), pakai secret sendiri.
CRON_SECRET=

# === Dual-Mode Storage Architecture ===
# Options: 'serverless' (Neon/Upstash HTTP) or 'selfhosted' (Native TCP Postgres/Redis)
STORAGE_MODE=serverless
REDIS_URL=redis://localhost:6379

# === Modular Architecture & Feature Flags ("Pakai Seperlunya") ===
# Lapis 1: Provider Allowlist (kosongkan untuk mengaktifkan seluruh 15 provider)
ENABLED_PROVIDERS=groq,google-ai-studio,custom

# Lapis 2: Feature Flags Runtime Toggles
ENABLE_DASHBOARD=true        # Matikan UI Next.js /dashboard untuk Headless Mode
ENABLE_DISCOVERY=true        # Matikan endpoint auto-discovery local LLM (SSRF protection)
ENABLE_SMART_ROUTING=true    # Matikan classifier "auto" untuk mode pure passthrough
ENABLE_MCP_SERVER=true       # Matikan endpoint MCP (/api/mcp) jika tak dibutuhkan AI Agent

# === Rate Limiting ===
# Batas request per menit per Gateway Token (fixed window)
CLIENT_RATE_LIMIT_RPM=60

# === Notifikasi & Alerting (Opsional) ===
# Kirim alert untuk circuit breaker, quota warning, dan health probe
ALERT_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=Free AI Gateway <alerts@resend.dev>
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
ALERT_WHATSAPP_TO=

# === CLI Configuration (bin/cli.ts) ===
# URL instance dan token untuk akses CLI management
GATEWAY_BASE_URL=http://localhost:3000
GATEWAY_ADMIN_TOKEN=

# === Provider API keys (contoh awal Fase 1 — bukan disimpan di sini untuk produksi) ===
# Di produksi, key provider disimpan terenkripsi di tabel api_keys, BUKAN di env var.
# Variabel ini hanya untuk uji lokal cepat sebelum key pool jalan.
GROQ_API_KEY_DEV=
OPENROUTER_API_KEY_DEV=

