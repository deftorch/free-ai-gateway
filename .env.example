# Salin ke .env, isi dengan key milik sendiri. JANGAN PERNAH commit .env asli.

# --- Mode & storage ---
MULTI_TENANT_MODE=off
DATABASE_URL=file:./local.db          # SQLite lokal untuk dev; ganti ke postgres:// untuk skala besar
KV_DRIVER=memory                       # memory | redis | cloudflare-kv

# --- Provider keys (contoh — tambah sesuai adapter yang aktif) ---
# Bisa lebih dari satu key per provider, dipisah koma, untuk multi-key pooling (§6)
GEMINI_API_KEYS=
NVIDIA_API_KEYS=
GROQ_API_KEYS=
OPENROUTER_API_KEYS=

# --- Keamanan ---
ENCRYPTION_KEY=                        # AES-256 key untuk enkripsi provider key at-rest — generate acak, jangan hardcode

# --- Registry (§10.3) ---
REGISTRY_SYNC_INTERVAL_HOURS=6
