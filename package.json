{
  "name": "free-ai-gateway",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Open-source AI Gateway: multi-provider, multi-channel (UI/CLI/MCP/SDK), free-tier-native key pooling.",
  "license": "MIT",
  "packageManager": "bun@1.3.14",
  "workspaces": ["packages/*", "adapters/*", "adapters/_contract-tests"],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:contract": "turbo run test --filter=./adapters/_contract-tests",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "anti-mock-check": "bash scripts/anti-mock-check.sh",
    "db:push": "bun --filter @free-ai-gateway/core db:push",
    "db:push:test": "bun --filter @free-ai-gateway/core db:push:test",
    "prepare": "husky"
  },
  "devDependencies": {
    "turbo": "^2.10.10",
    "typescript": "^7.0.2",
    "bun-types": "^1.3.14",
    "husky": "^9.1.0",
    "lint-staged": "^17.3.0",
    "eslint": "^10.8.1",
    "@eslint/js": "^10.0.1",
    "typescript-eslint": "^8.67.0",
    "prettier": "^3.3.0"
  },
  "lint-staged": {
    "packages/*/src/**/*.ts": ["eslint --fix"],
    "adapters/**/*.ts": ["eslint --fix"]
  }
}
