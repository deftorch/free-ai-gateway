{
  "name": "@free-ai-gateway/core",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "test": "vitest run --fileParallelism false",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:push:test": "DB_FILE_PATH=../../test.sqlite drizzle-kit push"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@libsql/client": "^0.17.4",
    "drizzle-kit": "^0.31.10",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
